# ------------------------------------------------------------------
# AI Career Copilot — environment variables (copy to .env / your host)
# All values are overrides; appsettings.json + appsettings.Development.json
# provide safe local defaults.
# ------------------------------------------------------------------

# --- PostgreSQL (overrides ConnectionStrings:DefaultConnection) ---
DB_CONNECTION=Host=localhost;Port=5432;Database=careercopilot;Username=postgres;Password=postgres

# --- JWT (overrides Jwt:Secret) - use a strong random key (>=32 chars) ---
Jwt__Secret=replace-with-a-long-random-secret-at-least-32-chars

# --- AI provider (overrides Ai:ApiKey and Ai:Model) ---
# Leave AI_API_KEY empty to run fully offline using deterministic fallbacks.
AI_API_KEY=
AI_MODEL=gemini-2.0-flash

# --- CORS (overrides Cors:Origins list) - repeat index for more origins ---
Cors__Origins__0=http://localhost:5173

# --- File storage root (relative to the API working dir by default) ---
# Storage__RootPath=/data/uploads

# --- ASP.NET Core basics ---
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:8080